{{ define "header" }}
	<header class="siteHeader">
		<div class="bar">
			<a href="#menu" id="menuLink" class="menu-link" aria-label="{{ if eq .Lang `fi` }}Valikko{{ else }}Menu{{ end }}"><span></span></a>
			<a class="brand" href="/{{ .Lang }}">
				<svg class="brandMark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
					<rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor"></rect>
					<path class="brandLines" d="M7 9h10M7 12.5h10M7 16h6"></path>
				</svg>
				<span class="brandName">Uutispuro</span>
			</a>
			<div class="search">
				<form action="/{{ .Lang }}/search" method="get" role="search">
					<label class="visually-hidden" for="q">{{ if eq .Lang `fi` }}Hae uutisista{{ else }}Search the news{{ end }}</label>
					<input type="text" name="q" id="q" value="{{ .SearchQuery }}" autocomplete="off" maxlength="100"
						placeholder="{{ if eq .Lang `fi` }}Hae uutisista{{ else }}Search the news{{ end }}" />
				</form>
			</div>
			<button class="themeToggle" id="themeToggle" type="button" aria-pressed="false"
				title="{{ if eq .Lang `fi` }}Vaihda teemaa{{ else }}Switch theme{{ end }}"
				aria-label="{{ if eq .Lang `fi` }}Vaihda vaalean ja tumman teeman välillä{{ else }}Switch between light and dark theme{{ end }}">
				<svg class="iconMoon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false" fill="currentColor">
					<path d="M20.5 14.8A8.6 8.6 0 0 1 9.2 3.5a8.6 8.6 0 1 0 11.3 11.3z"></path>
				</svg>
				<svg class="iconSun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false" fill="none"
					stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="12" cy="12" r="4.2"></circle>
					<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
				</svg>
			</button>
			<nav class="langs" aria-label="{{ if eq .Lang `fi` }}Kielet{{ else }}Languages{{ end }}">
				<a class="lang{{ if eq .Lang `fi` }} isCurrent{{ end }}" href="/fi" hreflang="fi" lang="fi">Suomi</a>
				<a class="lang{{ if eq .Lang `en` }} isCurrent{{ end }}" href="/en" hreflang="en" lang="en">English</a>
			</nav>
		</div>
	</header>
	<a class="sideScrim" href="#main" tabindex="-1" aria-label="{{ if eq .Lang `fi` }}Sulje valikko{{ else }}Close menu{{ end }}"></a>
{{ end }}
